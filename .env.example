# Railway Allocation System Environment Configuration
# Set to 'true' to use local rich mock data with zero external dependencies
VITE_USE_MOCK=true

# Use the Supabase project URL and publishable anon key (never a service-role key).
# Set VITE_USE_MOCK=false only after applying supabase/schema.sql.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
